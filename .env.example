# Default interview-ready, credential-free mode
INSTALLIQ_DATA_MODE=hosted
# Local Precisely Locate MCP HTTP endpoint (only needed in local mode)
PRECISELY_MCP_URL=http://127.0.0.1:8000/mcp
# Server-side only. Never expose these through NEXT_PUBLIC variables.
PRECISELY_API_KEY=
PRECISELY_API_SECRET=
# Browser map key. Restrict it by HTTP referrer in Google Cloud; do not use this for Precisely credentials.
GOOGLE_MAPS_API_KEY=
# Server-side AFDC / National Laboratory of the Rockies key for public EV-station context.
NREL_API_KEY=
# Optional search radius for public EV stations around the resolved site.
EV_STATION_SEARCH_RADIUS_MILES=5
# Server-side OpenAI key. Used only to explain normalized evidence; it never selects tools or changes policy.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# InstallIQ demo operating-area configuration, not Precisely data
SERVICE_BASE_LATITUDE=33.4484
SERVICE_BASE_LONGITUDE=-112.0740
SERVICE_RADIUS_MILES=35
